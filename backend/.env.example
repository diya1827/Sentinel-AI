# ─────────────────────────────────────────────────────────────────
# Sentinel AI — Backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_ENV=development            # development | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ── LLM (provider-agnostic; defaults to FREE Google Gemini) ──────
# Provider: gemini | groq | ollama | openrouter | openai | anthropic
# gemini/groq/ollama/openrouter/openai all share one OpenAI-compatible client,
# so switching is just these three values.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=
# Optional: override the endpoint. Leave blank to use the provider default.
#   gemini     → https://generativelanguage.googleapis.com/v1beta/openai/
#   groq       → https://api.groq.com/openai/v1        (LLM_MODEL=llama-3.3-70b-versatile)
#   ollama     → http://localhost:11434/v1             (no key needed; LLM_MODEL=llama3.1)
#   openrouter → https://openrouter.ai/api/v1
LLM_BASE_URL=

# Anthropic uses its own SDK/key when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Shared LLM tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_JSON_RETRIES=1

# ── Security scanners ────────────────────────────────────────────
SEMGREP_CONFIG=auto            # e.g. "auto", "p/security-audit", or a path
SEMGREP_TIMEOUT=300
GITLEAKS_TIMEOUT=120

# ── Workspace ────────────────────────────────────────────────────
# Directory where uploaded/cloned code is staged for scanning.
SCAN_WORKSPACE_DIR=/tmp/sentinel-scans
